# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
.venv/

# Game state snapshots (machine-specific; regenerated by snapshot.py)
snapshot.json
snapshot_region.json
snapshot_tiles.json

# Snapshot archive contents (region/save-specific; not portable across machines)
# The snapshots/ directory itself is tracked (via .gitkeep) so the path exists on clone.
snapshots/*/

# Agent runtime files
agent/spyglass_log.jsonl
agent/spyglass_evals.jsonl
agent/spyglass_settings.json
